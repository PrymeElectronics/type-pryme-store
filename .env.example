# Whop: Dashboard > Developer > Create API key
WHOP_API_KEY=
# Whop business ID, starts with biz_
WHOP_COMPANY_ID=
WHOP_CURRENCY=zar

# Password for /admin
ADMIN_PASSWORD=

# Your WhatsApp number in international format, no + or spaces (e.g. 27821234567)
NEXT_PUBLIC_WHATSAPP=

# Your live web address, e.g. https://pryme-store.vercel.app
NEXT_PUBLIC_SITE_URL=

# Added automatically when you connect Upstash Redis in Vercel
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
